# Lambda Labs API Configuration
# Copy this file to .env.lambda and fill in your API key
#
# Get your API key from: https://cloud.lambda.ai/api-keys

# Required: Your Lambda Labs API key
LAMBDA_API_KEY=your-api-key-here

# Optional: Preferred instance types (space-separated, in order of preference)
# Default: gpu_1x_h100_pcie gpu_1x_a100 gpu_1x_a10
LAMBDA_PREFERRED_TYPES="gpu_1x_h100_pcie gpu_1x_a100 gpu_1x_a10"

# Optional: Preferred regions (space-separated, in order of preference)
# Default: us-west-1 us-east-1 us-west-2 us-south-1
LAMBDA_PREFERRED_REGIONS="us-west-1 us-east-1 us-west-2 us-south-1"

# Optional: Local SSH tunnel port for worker
# Default: 8002
LAMBDA_LOCAL_PORT=8002

# Optional: Remote worker port on Lambda instance
# Default: 8001
LAMBDA_WORKER_PORT=8001

# Usage:
# 1. Copy this file: cp .env.lambda.example .env.lambda
# 2. Edit .env.lambda with your API key
# 3. Load environment: source .env.lambda
# 4. Launch instance: bash scripts/lambda-launch.sh
# 5. Kill instances: bash scripts/lambda-killall.sh
